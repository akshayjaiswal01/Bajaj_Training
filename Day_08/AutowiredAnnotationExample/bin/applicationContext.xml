<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="
    http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context.xsd">

	<context:annotation-config/>

	<bean id="department" class="com.training.org.Department">
		<constructor-arg value="101" type="int"></constructor-arg>
		<constructor-arg value="HR" type="String"></constructor-arg>
		<constructor-arg value="Ibis Hotel Pune" type="String"></constructor-arg>
	</bean>
	
	<bean id="employee" class="com.training.org.Employee">
		<constructor-arg value="1" type="int"></constructor-arg>
		<constructor-arg value="Akshay Jaiswal" type="String"></constructor-arg>
	</bean>

</beans>