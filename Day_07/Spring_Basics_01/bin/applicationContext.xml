<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
    http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- constructor injection <bean id="studentbean" class="com.training.org.Student"> 
		<constructor-arg value="Akshay Jaiswal" type="String"></constructor-arg> 
		<constructor-arg value="12th Std" type="String"></constructor-arg> <constructor-arg 
		value="99.40" type="double"></constructor-arg> <constructor-arg> <list> <value>Math</value> 
		<value>Science</value> <value>English</value> </list> </constructor-arg> 
		</bean> -->

	<bean id="studentbean" class="com.training.org.Student">

		<property name="name" value="Akshay Jaiswal" />
		<property name="std" value="12th Std" />
		<property name="avgMarks" value="99.40" />

		<property name="subjects">
			<list>
				<value>Math</value>
				<value>Science</value>
				<value>English</value>
			</list>
		</property>

	</bean>



	<bean id="teacherbean" class="com.training.org.Teacher">
		<constructor-arg value="Shital Madake" type="String"></constructor-arg>
		<constructor-arg value="Java" type="String"></constructor-arg>
		<constructor-arg value="9856321456" type="long"></constructor-arg>
		<constructor-arg value="12th std" type="String"></constructor-arg>
	</bean>


	<bean id="project1" class="com.training.org.Project">
		<property name="projectId" value="1" />
		<property name="projectName" value="Digital Wallet" />
	</bean>

	<bean id="project2" class="com.training.org.Project">
		<property name="projectId" value="2" />
		<property name="projectName" value="Bank Management System" />
	</bean>

	<bean id="project3" class="com.training.org.Project">
		<property name="projectId" value="3" />
		<property name="projectName" value="Medicine Tracker" />
	</bean>




	<bean id="cert1" class="com.training.org.Certification">
		<property name="id" value="101" />
		<property name="name" value="Java Programming" />
		<property name="provider" value="Oracle" />
		<property name="year" value="2023" />
	</bean>

	<bean id="cert2" class="com.training.org.Certification">
		<property name="id" value="102" />
		<property name="name" value="Spring Framework" />
		<property name="provider" value="Udemy" />
		<property name="year" value="2024" />
	</bean>

	<bean id="cert3" class="com.training.org.Certification">
		<property name="id" value="103" />
		<property name="name" value="System Design" />
		<property name="provider" value="Coursera" />
		<property name="year" value="2025" />
	</bean>

	<bean id="payslip" class="com.training.org.Payslip">
		<property name="basic" value="50000" />
		<property name="hra" value="10000" />
		<property name="da" value="5000" />
		<property name="deductions" value="3000" />
	</bean>
	
	

	<bean id="employeebean" class="com.training.org.Employee">
		<property name="empId" value="101"></property>
		<property name="name" value="Akshay Jaiswal"></property>
		<property name="salary" value="50000"></property>
		<property name="phoneNumber" value="9856321456"></property>
		<property name="designation" value="Developer"></property>

		<property name="address">
			<list>
				<value>Pune</value>
				<value>Maharashtra</value>
				<value>India</value>
			</list>
		</property>

		<property name="technologies">
			<list>
				<value>Java</value>
				<value>Spring</value>
				<value>Microservices</value>
			</list>
		</property>

		<property name="projects">
			<list>
				<ref bean="project1" />
				<ref bean="project2" />
				<ref bean="project3" />
			</list>
		</property>

		<property name="certifications">
			<list>
				<ref bean="cert1" />
				<ref bean="cert2" />
				<ref bean="cert3" />
			</list>
		</property>
		
		<property name="payslip" ref="payslip"></property>


	</bean>

</beans>